<Project Sdk="Microsoft.NET.Sdk">

  <!-- A DTO field that nothing fills fails the build (Mapperly RMG012) -->
  <PropertyGroup>
    <WarningsAsErrors>$(WarningsAsErrors);RMG012</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Source generator: the mapping code is generated at build time, nothing ships at runtime -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Riok.Mapperly" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SwimSchool.Domain\SwimSchool.Domain.csproj" />
  </ItemGroup>

</Project>
